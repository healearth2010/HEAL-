<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.2.2 is the localhost address for Android emulator -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Also allow localhost and 127.0.0.1 for physical device testing -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Allow cleartext for EC2 backend -->
        <domain includeSubdomains="true">ec2-13-234-204-250.ap-south-1.compute.amazonaws.com</domain>
    </domain-config>
</network-security-config>
